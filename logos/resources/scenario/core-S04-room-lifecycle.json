{
  "scenario_id": "core-S04",
  "scenario_name": "协作房间生命周期",
  "module": "core",
  "description": "E2E API 编排：Owner 注册登录 → 创建 diagram → 创建 room → 邀请 → Guest 注册登录 → preview → accept → 成员列表 → 409 重复绑定 → 清理",
  "alignment": "core-S04-room-lifecycle.md",
  "version": "2.0.0",
  "base_url": "http://localhost:3000",
  "preconditions": [
    "V2 auth + rooms API 已实现并运行",
    "数据库为干净状态或使用隔离测试库",
    "测试邮箱未被占用"
  ],
  "variables": {
    "owner_email": "s04-orchestration-owner@coldrawdb.test",
    "guest_email": "s04-orchestration-guest@coldrawdb.test",
    "password": "TestPass123"
  },
  "steps": [
    {
      "step_id": 1,
      "name": "Owner 注册",
      "alignment_step": "S03.1 + S04 前置",
      "method": "POST",
      "path": "/api/v1/auth/register",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${owner_email}",
          "password": "${password}",
          "displayName": "S04 Owner"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "email": { "equals": "${owner_email}" },
          "userId": { "type": "uuid" }
        }
      },
      "extract": {
        "owner_user_id": "$.userId"
      }
    },
    {
      "step_id": 2,
      "name": "Owner 登录",
      "alignment_step": "S03.2",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${owner_email}",
          "password": "${password}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "accessToken": { "type": "string" },
          "tokenType": { "equals": "Bearer" },
          "expiresIn": { "type": "integer" }
        }
      },
      "extract": {
        "owner_token": "$.accessToken"
      }
    },
    {
      "step_id": 3,
      "name": "Owner 创建 diagram（V1 API）",
      "alignment_step": "S04.1 前置",
      "method": "POST",
      "path": "/api/v1/diagrams",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "title": "S04 Room Test Diagram",
          "tables": [
            {
              "id": "s04-t1",
              "name": "users",
              "x": 100,
              "y": 100,
              "comment": "",
              "fields": [
                { "id": "s04-f1", "name": "id", "type": "INT", "primary": true, "increment": true, "notNull": true, "unique": false }
              ]
            }
          ],
          "references": [],
          "areas": [],
          "notes": []
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "id": { "type": "uuid" },
          "title": { "equals": "S04 Room Test Diagram" },
          "revision": { "equals": 0 }
        }
      },
      "extract": {
        "diagram_id": "$.id"
      }
    },
    {
      "step_id": 4,
      "name": "Owner 创建 room",
      "alignment_step": "S04.1 §3 Step 3–16b",
      "method": "POST",
      "path": "/api/v1/rooms",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer ${owner_token}"
        },
        "body": {
          "name": "评审周会",
          "diagramId": "${diagram_id}"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "id": { "type": "uuid" },
          "name": { "equals": "评审周会" },
          "diagramId": { "equals": "${diagram_id}" },
          "ownerId": { "equals": "${owner_user_id}" }
        }
      },
      "extract": {
        "room_id": "$.id"
      }
    },
    {
      "step_id": 5,
      "name": "Owner 获取 room 详情",
      "alignment_step": "S04.1 验证",
      "method": "GET",
      "path": "/api/v1/rooms/${room_id}",
      "request": {
        "headers": {
          "Authorization": "Bearer ${owner_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "id": { "equals": "${room_id}" },
          "myRole": { "equals": "owner" },
          "memberCount": { "equals": 1 }
        }
      }
    },
    {
      "step_id": 6,
      "name": "Owner 创建 editor 邀请",
      "alignment_step": "S04.2 §4 Step 3–11",
      "method": "POST",
      "path": "/api/v1/rooms/${room_id}/invites",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer ${owner_token}"
        },
        "body": {
          "role": "editor"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "token": { "type": "string" },
          "role": { "equals": "editor" },
          "inviteUrl": { "type": "string" },
          "expiresAt": { "type": "string" }
        }
      },
      "extract": {
        "invite_token": "$.token"
      }
    },
    {
      "step_id": 7,
      "name": "匿名 preview 邀请",
      "alignment_step": "S04.3 §5 Step 3–8b",
      "method": "GET",
      "path": "/api/v1/rooms/invites/${invite_token}",
      "request": {},
      "expect": {
        "status": 200,
        "json": {
          "roomName": { "equals": "评审周会" },
          "diagramId": { "equals": "${diagram_id}" },
          "role": { "equals": "editor" }
        }
      }
    },
    {
      "step_id": 8,
      "name": "Guest 注册",
      "alignment_step": "S04.3 被邀请人",
      "method": "POST",
      "path": "/api/v1/auth/register",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${guest_email}",
          "password": "${password}",
          "displayName": "S04 Guest"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "userId": { "type": "uuid" }
        }
      },
      "extract": {
        "guest_user_id": "$.userId"
      }
    },
    {
      "step_id": 9,
      "name": "Guest 登录",
      "alignment_step": "S04.3",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${guest_email}",
          "password": "${password}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "accessToken": { "type": "string" }
        }
      },
      "extract": {
        "guest_token": "$.accessToken"
      }
    },
    {
      "step_id": 10,
      "name": "Guest 接受邀请",
      "alignment_step": "S04.3 §5 Step 12–18",
      "method": "POST",
      "path": "/api/v1/rooms/invites/${invite_token}/accept",
      "request": {
        "headers": {
          "Authorization": "Bearer ${guest_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "roomId": { "equals": "${room_id}" },
          "diagramId": { "equals": "${diagram_id}" },
          "role": { "equals": "editor" }
        }
      }
    },
    {
      "step_id": 11,
      "name": "Owner 查看成员列表（2 人）",
      "alignment_step": "S04.4 members panel",
      "method": "GET",
      "path": "/api/v1/rooms/${room_id}/members",
      "request": {
        "headers": {
          "Authorization": "Bearer ${owner_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "items": { "length": 2 }
        }
      }
    },
    {
      "step_id": 12,
      "name": "Guest 获取 room 详情 role=editor",
      "alignment_step": "S04.3 验证",
      "method": "GET",
      "path": "/api/v1/rooms/${room_id}",
      "request": {
        "headers": {
          "Authorization": "Bearer ${guest_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "myRole": { "equals": "editor" },
          "memberCount": { "equals": 2 }
        }
      }
    },
    {
      "step_id": 13,
      "name": "同一 diagram 重复创建 room → 409",
      "alignment_step": "EX-11.1",
      "method": "POST",
      "path": "/api/v1/rooms",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer ${owner_token}"
        },
        "body": {
          "name": "重复房间",
          "diagramId": "${diagram_id}"
        }
      },
      "expect": {
        "status": 409,
        "json": {
          "code": { "equals": "ROOM_DIAGRAM_TAKEN" },
          "existingRoomId": { "equals": "${room_id}" }
        }
      }
    },
    {
      "step_id": 14,
      "name": "Owner 移除 Guest",
      "alignment_step": "S04.4 §6 Step 3–9",
      "method": "DELETE",
      "path": "/api/v1/rooms/${room_id}/members/${guest_user_id}",
      "request": {
        "headers": {
          "Authorization": "Bearer ${owner_token}"
        }
      },
      "expect": {
        "status": 204
      }
    },
    {
      "step_id": 15,
      "name": "Guest 再次访问 room → 403 NOT_A_MEMBER",
      "alignment_step": "EX-13.1",
      "method": "GET",
      "path": "/api/v1/rooms/${room_id}",
      "request": {
        "headers": {
          "Authorization": "Bearer ${guest_token}"
        }
      },
      "expect": {
        "status": 403,
        "json": {
          "code": { "equals": "NOT_A_MEMBER" }
        }
      }
    },
    {
      "step_id": 16,
      "name": "Owner 归档 room",
      "alignment_step": "S04 cleanup",
      "method": "DELETE",
      "path": "/api/v1/rooms/${room_id}",
      "request": {
        "headers": {
          "Authorization": "Bearer ${owner_token}"
        }
      },
      "expect": {
        "status": 204
      }
    },
    {
      "step_id": 17,
      "name": "清理 diagram",
      "alignment_step": "V1 cleanup",
      "method": "DELETE",
      "path": "/api/v1/diagrams/${diagram_id}",
      "request": {},
      "expect": {
        "status": 204
      }
    }
  ],
  "postconditions": [
    "room 已归档，diagram 已删除",
    "测试用户可保留或按测试策略清理"
  ],
  "expected_outcome": {
    "total_steps": 17,
    "expected_pass": 17,
    "tolerance": "0 failures"
  }
}
