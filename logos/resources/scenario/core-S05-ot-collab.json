{
  "scenario_id": "core-S05",
  "scenario_name": "OT 实时协作",
  "module": "core",
  "description": "E2E 编排：room 前置 → collab head → WS connect/op/ack/remote_op → REST ops 补发验证 → viewer READ_ONLY → 清理",
  "alignment": "core-S05-ot-collab.md",
  "version": "2.0.0",
  "base_url": "http://localhost:3000",
  "ws_base_url": "ws://localhost:3000",
  "preconditions": [
    "V2 auth + rooms + collab-server 已实现并运行",
    "HTTP 与 WS 共用同一 host（或 ws_base_url 指向 collab 代理）",
    "数据库为干净状态；测试邮箱未被占用"
  ],
  "variables": {
    "owner_email": "s05-orchestration-owner@coldrawdb.test",
    "guest_email": "s05-orchestration-guest@coldrawdb.test",
    "viewer_email": "s05-orchestration-viewer@coldrawdb.test",
    "password": "TestPass123",
    "table_id": "s05-ot-table-orders"
  },
  "steps": [
    {
      "step_id": 1,
      "transport": "http",
      "name": "Owner 注册",
      "alignment_step": "S03.1 + S04/S05 前置",
      "method": "POST",
      "path": "/api/v1/auth/register",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${owner_email}",
          "password": "${password}",
          "displayName": "S05 Owner"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "userId": { "type": "uuid" }
        }
      },
      "extract": {
        "owner_user_id": "$.userId"
      }
    },
    {
      "step_id": 2,
      "transport": "http",
      "name": "Owner 登录",
      "alignment_step": "S03.2",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${owner_email}",
          "password": "${password}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "accessToken": { "type": "string" },
          "tokenType": { "equals": "Bearer" }
        }
      },
      "extract": {
        "owner_token": "$.accessToken"
      }
    },
    {
      "step_id": 3,
      "transport": "http",
      "name": "Owner 创建 diagram",
      "alignment_step": "S04.1 前置",
      "method": "POST",
      "path": "/api/v1/diagrams",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "title": "S05 OT Test Diagram",
          "tables": [],
          "references": [],
          "areas": [],
          "notes": []
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "id": { "type": "uuid" },
          "revision": { "equals": 0 }
        }
      },
      "extract": {
        "diagram_id": "$.id"
      }
    },
    {
      "step_id": 4,
      "transport": "http",
      "name": "Owner 创建 room",
      "alignment_step": "S04.1",
      "method": "POST",
      "path": "/api/v1/rooms",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer ${owner_token}"
        },
        "body": {
          "name": "S05 OT Room",
          "diagramId": "${diagram_id}"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "id": { "type": "uuid" },
          "diagramId": { "equals": "${diagram_id}" }
        }
      },
      "extract": {
        "room_id": "$.id"
      }
    },
    {
      "step_id": 5,
      "transport": "http",
      "name": "Guest 注册并登录",
      "alignment_step": "S04.3 被邀请人",
      "method": "POST",
      "path": "/api/v1/auth/register",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${guest_email}",
          "password": "${password}",
          "displayName": "S05 Guest"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "step_id": 6,
      "transport": "http",
      "name": "Guest 登录",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${guest_email}",
          "password": "${password}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "accessToken": { "type": "string" }
        }
      },
      "extract": {
        "guest_token": "$.accessToken"
      }
    },
    {
      "step_id": 7,
      "transport": "http",
      "name": "Owner 创建 editor 邀请",
      "alignment_step": "S04.2",
      "method": "POST",
      "path": "/api/v1/rooms/${room_id}/invites",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer ${owner_token}"
        },
        "body": {
          "role": "editor"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "token": { "type": "string" }
        }
      },
      "extract": {
        "invite_token": "$.token"
      }
    },
    {
      "step_id": 8,
      "transport": "http",
      "name": "Guest 接受邀请",
      "alignment_step": "S04.3",
      "method": "POST",
      "path": "/api/v1/rooms/invites/${invite_token}/accept",
      "request": {
        "headers": {
          "Authorization": "Bearer ${guest_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "roomId": { "equals": "${room_id}" },
          "role": { "equals": "editor" }
        }
      }
    },
    {
      "step_id": 9,
      "transport": "http",
      "name": "GET collab head（初始 serverRev=0）",
      "alignment_step": "S05.1 §3 / collab.yaml getCollabHead",
      "method": "GET",
      "path": "/api/v1/rooms/${room_id}/collab/head",
      "request": {
        "headers": {
          "Authorization": "Bearer ${owner_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "roomId": { "equals": "${room_id}" },
          "diagramId": { "equals": "${diagram_id}" },
          "serverRev": { "equals": 0 }
        }
      }
    },
    {
      "step_id": 10,
      "transport": "websocket",
      "name": "Owner WS 连接 → connected",
      "alignment_step": "S05.1 §3 Step 8b",
      "connection": {
        "alias": "ws_owner",
        "url": "${ws_base_url}/ws/rooms/${room_id}?token=${owner_token}"
      },
      "messages": [
        {
          "direction": "receive",
          "timeout_ms": 3000,
          "expect": {
            "json": {
              "type": { "equals": "connected" },
              "serverRev": { "equals": 0 },
              "diagramId": { "equals": "${diagram_id}" },
              "yourRole": { "equals": "owner" }
            }
          },
          "extract": {
            "head_rev": "$.serverRev"
          }
        }
      ]
    },
    {
      "step_id": 11,
      "transport": "websocket",
      "name": "Owner 发送 table.create op → ack",
      "alignment_step": "S05.2 §4 Step 4–12",
      "connection": {
        "alias": "ws_owner"
      },
      "messages": [
        {
          "direction": "send",
          "body": {
            "type": "op",
            "clientRev": 1,
            "op": {
              "type": "table.create",
              "targetId": "${table_id}",
              "changes": {
                "name": "orders",
                "x": 220,
                "y": 180
              }
            }
          }
        },
        {
          "direction": "receive",
          "timeout_ms": 3000,
          "expect": {
            "json": {
              "type": { "equals": "ack" },
              "serverRev": { "equals": 1 },
              "appliedOp": {
                "type": { "equals": "table.create" }
              }
            }
          },
          "extract": {
            "server_rev": "$.serverRev"
          }
        }
      ]
    },
    {
      "step_id": 12,
      "transport": "websocket",
      "name": "Guest WS 连接 → connected（head rev=1）",
      "alignment_step": "S05.1 + S05.2 远端同步前置",
      "connection": {
        "alias": "ws_guest",
        "url": "${ws_base_url}/ws/rooms/${room_id}?token=${guest_token}"
      },
      "messages": [
        {
          "direction": "receive",
          "timeout_ms": 3000,
          "expect": {
            "json": {
              "type": { "equals": "connected" },
              "serverRev": { "equals": 1 }
            }
          }
        }
      ]
    },
    {
      "step_id": 13,
      "transport": "websocket",
      "name": "Guest 收到 remote_op（ST-C-01）",
      "alignment_step": "S05.2 §4 Step 13–15",
      "connection": {
        "alias": "ws_guest"
      },
      "messages": [
        {
          "direction": "receive",
          "timeout_ms": 500,
          "expect": {
            "json": {
              "type": { "equals": "remote_op" },
              "serverRev": { "equals": 1 },
              "authorId": { "equals": "${owner_user_id}" },
              "op": {
                "type": { "equals": "table.create" },
                "targetId": { "equals": "${table_id}" }
              }
            }
          }
        }
      ]
    },
    {
      "step_id": 14,
      "transport": "http",
      "name": "REST 补发验证 collab/ops",
      "alignment_step": "S05.4 §6 HTTP 等价",
      "method": "GET",
      "path": "/api/v1/rooms/${room_id}/collab/ops?afterRev=0&limit=100",
      "request": {
        "headers": {
          "Authorization": "Bearer ${guest_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "fromRev": { "equals": 0 },
          "toRev": { "equals": 1 },
          "items": {
            "length": 1,
            "0": {
              "serverRev": { "equals": 1 },
              "opType": { "equals": "table.create" },
              "userId": { "equals": "${owner_user_id}" }
            }
          }
        }
      }
    },
    {
      "step_id": 15,
      "transport": "websocket",
      "name": "Guest 发送 sync lastRev=1 → 空 batch",
      "alignment_step": "S05.4 §6 Step 8–12",
      "connection": {
        "alias": "ws_guest"
      },
      "messages": [
        {
          "direction": "send",
          "body": {
            "type": "sync",
            "lastRev": 1
          }
        },
        {
          "direction": "receive",
          "timeout_ms": 3000,
          "expect": {
            "json": {
              "type": { "equals": "sync" },
              "serverRev": { "equals": 1 },
              "ops": { "length": 0 }
            }
          }
        }
      ]
    },
    {
      "step_id": 16,
      "transport": "http",
      "name": "GET collab head 确认 serverRev=1",
      "alignment_step": "S05.2 持久化头指针",
      "method": "GET",
      "path": "/api/v1/rooms/${room_id}/collab/head",
      "request": {
        "headers": {
          "Authorization": "Bearer ${owner_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "serverRev": { "equals": 1 }
        }
      }
    },
    {
      "step_id": 17,
      "transport": "http",
      "name": "Viewer 注册并登录",
      "alignment_step": "EX-5.2 前置",
      "method": "POST",
      "path": "/api/v1/auth/register",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${viewer_email}",
          "password": "${password}",
          "displayName": "S05 Viewer"
        }
      },
      "expect": {
        "status": 201
      }
    },
    {
      "step_id": 18,
      "transport": "http",
      "name": "Viewer 登录",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "request": {
        "headers": { "Content-Type": "application/json" },
        "body": {
          "email": "${viewer_email}",
          "password": "${password}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "accessToken": { "type": "string" }
        }
      },
      "extract": {
        "viewer_token": "$.accessToken"
      }
    },
    {
      "step_id": 19,
      "transport": "http",
      "name": "Owner 创建 viewer 邀请",
      "method": "POST",
      "path": "/api/v1/rooms/${room_id}/invites",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer ${owner_token}"
        },
        "body": {
          "role": "viewer"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "token": { "type": "string" }
        }
      },
      "extract": {
        "viewer_invite_token": "$.token"
      }
    },
    {
      "step_id": 20,
      "transport": "http",
      "name": "Viewer 接受邀请",
      "method": "POST",
      "path": "/api/v1/rooms/invites/${viewer_invite_token}/accept",
      "request": {
        "headers": {
          "Authorization": "Bearer ${viewer_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "role": { "equals": "viewer" }
        }
      }
    },
    {
      "step_id": 21,
      "transport": "websocket",
      "name": "Viewer WS 连接后发送 op → READ_ONLY",
      "alignment_step": "EX-5.2",
      "connection": {
        "alias": "ws_viewer",
        "url": "${ws_base_url}/ws/rooms/${room_id}?token=${viewer_token}"
      },
      "messages": [
        {
          "direction": "receive",
          "timeout_ms": 3000,
          "expect": {
            "json": {
              "type": { "equals": "connected" },
              "yourRole": { "equals": "viewer" }
            }
          }
        },
        {
          "direction": "send",
          "body": {
            "type": "op",
            "op": {
              "type": "table.create",
              "targetId": "viewer-blocked-table",
              "changes": { "name": "blocked" }
            }
          }
        },
        {
          "direction": "receive",
          "timeout_ms": 3000,
          "expect": {
            "json": {
              "type": { "equals": "error" },
              "code": { "equals": "READ_ONLY" }
            }
          }
        }
      ]
    },
    {
      "step_id": 22,
      "transport": "http",
      "name": "collab/ops afterRev=1 仍仅 1 条（viewer op 未写入）",
      "alignment_step": "EX-5.2 副作用",
      "method": "GET",
      "path": "/api/v1/rooms/${room_id}/collab/ops?afterRev=0",
      "request": {
        "headers": {
          "Authorization": "Bearer ${owner_token}"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "toRev": { "equals": 1 },
          "items": { "length": 1 }
        }
      }
    },
    {
      "step_id": 23,
      "transport": "http",
      "name": "关闭 WS 连接（显式 teardown）",
      "alignment_step": "清理前置",
      "connection": {
        "action": "close_all",
        "aliases": ["ws_owner", "ws_guest", "ws_viewer"]
      }
    },
    {
      "step_id": 24,
      "transport": "http",
      "name": "Owner 归档 room",
      "method": "DELETE",
      "path": "/api/v1/rooms/${room_id}",
      "request": {
        "headers": {
          "Authorization": "Bearer ${owner_token}"
        }
      },
      "expect": {
        "status": 204
      }
    },
    {
      "step_id": 25,
      "transport": "http",
      "name": "清理 diagram",
      "method": "DELETE",
      "path": "/api/v1/diagrams/${diagram_id}",
      "request": {},
      "expect": {
        "status": 204
      }
    }
  ],
  "postconditions": [
    "room 已归档，diagram 已删除",
    "operation_log 随 room CASCADE 清理",
    "WS 连接已全部关闭"
  ],
  "expected_outcome": {
    "total_steps": 25,
    "expected_pass": 25,
    "tolerance": "0 failures",
    "covers": ["UT-C-01", "UT-C-02", "UT-C-04", "UT-C-05", "ST-C-01"]
  }
}
