# Delta — core-S02-shared-link-load.json（diagram-api-auth）

> 模块：core | 提案：diagram-api-auth
> 目标：编排切换为「A 登录态 + share_token 匿名读」模型（`COLDRAWDB_DIAGRAMS_AUTH=on` 下编排）；新增 A 铸造分享令牌步骤，B 的匿名加载全部携带 `?share_token=`。

## MODIFIED — 全文件（scenario 定义）

```json
{
  "scenario_id": "core-S02",
  "scenario_name": "分享链接加载",
  "module": "core",
  "description": "E2E API 编排：A 登录创建 diagram → A 编辑保存 → A 铸造 share_token → B 凭分享链接匿名 GET 加载 → 验证 A 与 B 数据一致（diagram-api-auth：flag=on 下编排，匿名读唯一豁免为 share_token）",
  "alignment": "core-S02-load-shared-diagram.md",
  "version": "1.1.0",
  "base_url": "http://localhost:3000",
  "preconditions": [
    "后端服务运行中，COLDRAWDB_DIAGRAMS_AUTH=on",
    "数据库为干净状态",
    "A 已登录：POST /api/v1/auth/login 取得 access_token（编排变量 ${access_token}）"
  ],
  "variables": {},
  "steps": [
    {
      "step_id": 1,
      "name": "A 创建 diagram（含 1 张表，登录态）",
      "method": "POST",
      "path": "/api/v1/diagrams",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer ${access_token}"
        },
        "body": {
          "title": "Shared Diagram",
          "tables": [
            {
              "id": "shared-t1",
              "name": "users",
              "x": 100,
              "y": 100,
              "comment": "",
              "fields": [
                { "id": "sf1", "name": "id", "type": "INT", "primary": true, "increment": true, "notNull": true, "unique": false },
                { "id": "sf2", "name": "name", "type": "VARCHAR(255)", "primary": false, "notNull": true, "unique": false }
              ]
            }
          ],
          "references": [],
          "areas": [
            {
              "id": "sa1",
              "name": "User Area",
              "x": 50,
              "y": 50,
              "width": 300,
              "height": 200,
              "color": "#e0f2fe"
            }
          ],
          "notes": [
            {
              "id": "sn1",
              "x": 200,
              "y": 200,
              "content": "Test note",
              "color": "#fef3c7"
            }
          ]
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "id": { "type": "uuid" },
          "title": { "equals": "Shared Diagram" },
          "revision": { "equals": 0 }
        }
      },
      "extract": {
        "diagram_id": "$.id"
      }
    },
    {
      "step_id": 2,
      "name": "A 编辑保存（增 1 字段，登录态）",
      "method": "PUT",
      "path": "/api/v1/diagrams/${diagram_id}",
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer ${access_token}"
        },
        "body": {
          "title": "Shared Diagram",
          "revision": 0,
          "tables": [
            {
              "id": "shared-t1",
              "name": "users",
              "x": 100,
              "y": 100,
              "comment": "",
              "fields": [
                { "id": "sf1", "name": "id", "type": "INT", "primary": true, "increment": true, "notNull": true, "unique": false },
                { "id": "sf2", "name": "name", "type": "VARCHAR(255)", "primary": false, "notNull": true, "unique": false },
                { "id": "sf3", "name": "email", "type": "VARCHAR(255)", "primary": false, "notNull": false, "unique": true }
              ]
            }
          ],
          "references": [],
          "areas": [
            {
              "id": "sa1",
              "name": "User Area",
              "x": 50,
              "y": 50,
              "width": 300,
              "height": 200,
              "color": "#e0f2fe"
            }
          ],
          "notes": [
            {
              "id": "sn1",
              "x": 200,
              "y": 200,
              "content": "Test note",
              "color": "#fef3c7"
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "revision": { "equals": 1 },
          "tables": {
            "length": 1,
            "0": {
              "fields": { "length": 3 }
            }
          }
        }
      }
    },
    {
      "step_id": 3,
      "name": "A 铸造分享令牌（POST /diagrams/{id}/share，登录态）",
      "method": "POST",
      "path": "/api/v1/diagrams/${diagram_id}/share",
      "request": {
        "headers": { "Authorization": "Bearer ${access_token}" }
      },
      "expect": {
        "status": 200,
        "json": {
          "data": {
            "id": { "equals": "${diagram_id}" },
            "share_token": { "type": "string" }
          }
        }
      },
      "extract": {
        "share_token": "$.data.share_token"
      }
    },
    {
      "step_id": 4,
      "name": "B 通过分享链接匿名 GET 加载（share_token 豁免，无 Authorization）",
      "method": "GET",
      "path": "/api/v1/diagrams/${diagram_id}?share_token=${share_token}",
      "request": {
        "headers": {
          "User-Agent": "Mozilla/5.0 (compatible; Browser B)"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "id": { "equals": "${diagram_id}" },
          "title": { "equals": "Shared Diagram" },
          "revision": { "equals": 1 },
          "tables": {
            "length": 1,
            "0": {
              "name": { "equals": "users" },
              "fields": { "length": 3 }
            }
          },
          "areas": { "length": 1 },
          "notes": { "length": 1 }
        }
      }
    },
    {
      "step_id": 5,
      "name": "B 验证数据一致性（与 A 提交一致，share_token 匿名读）",
      "method": "GET",
      "path": "/api/v1/diagrams/${diagram_id}?share_token=${share_token}",
      "request": {},
      "expect": {
        "status": 200,
        "json": {
          "tables": {
            "0": {
              "fields": {
                "0": { "name": { "equals": "id" } },
                "1": { "name": { "equals": "name" } },
                "2": { "name": { "equals": "email" } }
              }
            }
          }
        }
      }
    },
    {
      "step_id": 6,
      "name": "B 无 token 且无 share_token 匿名 GET → 401（flag=on 强制）",
      "method": "GET",
      "path": "/api/v1/diagrams/${diagram_id}",
      "request": {},
      "expect": {
        "status": 401
      }
    },
    {
      "step_id": 7,
      "name": "B share_token 不匹配 → 404（不暴露图存在性）",
      "method": "GET",
      "path": "/api/v1/diagrams/${diagram_id}?share_token=wrong-token",
      "request": {},
      "expect": {
        "status": 404
      }
    },
    {
      "step_id": 8,
      "name": "A 轮换分享令牌 → 旧 share_token 立即失效（404）",
      "method": "POST",
      "path": "/api/v1/diagrams/${diagram_id}/share",
      "request": {
        "headers": { "Authorization": "Bearer ${access_token}" }
      },
      "expect": {
        "status": 200,
        "json": {
          "data": {
            "id": { "equals": "${diagram_id}" },
            "share_token": { "type": "string" }
          }
        }
      },
      "extract": {
        "share_token_v2": "$.data.share_token"
      }
    },
    {
      "step_id": 9,
      "name": "B 用旧 share_token 再读 → 404（轮换生效）",
      "method": "GET",
      "path": "/api/v1/diagrams/${diagram_id}?share_token=${share_token}",
      "request": {},
      "expect": {
        "status": 404
      }
    },
    {
      "step_id": 10,
      "name": "A 清理：DELETE diagram（登录态）",
      "method": "DELETE",
      "path": "/api/v1/diagrams/${diagram_id}",
      "request": {
        "headers": { "Authorization": "Bearer ${access_token}" }
      },
      "expect": {
        "status": 204
      }
    }
  ],
  "postconditions": [
    "数据库中 ${diagram_id} 相关行已全部清理"
  ],
  "expected_outcome": {
    "total_steps": 10,
    "expected_pass": 10,
    "tolerance": "0 failures"
  }
}
