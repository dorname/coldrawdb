      "large_fixture": "${S06_LARGE_FIXTURE}",
      "chunked_diagram_name": "S06 MCP Chunked 54 Tables"
    },
    "steps": [
      {
        "step_id": 1,
        "name": "创建仅用于分片写入的空图",
        "method": "tools/call",
        "tool": "create_diagram",
        "arguments": { "name": "${chunked_diagram_name}", "database": "postgresql" },
        "expect": { "isError": false },
        "extract": { "chunked_diagram_id": "$.structuredContent.id" }
      },
      {
        "step_id": 2,
        "name": "逐表 create，保留完整 fields 并收集实际 ID 映射",
        "for_each": {
          "items": "${large_fixture.tables}",
          "as": "table_chunk",
          "serial": true,
          "max_argument_bytes": 49152
        },
        "method": "tools/call",
        "tool": "update_table",
        "arguments": {
          "id": "${chunked_diagram_id}",
          "action": "create",
          "table_id": "${table_chunk.id}",
          "name": "${table_chunk.name}",
          "comment": "${table_chunk.comment}",
          "x": "${table_chunk.x}",
          "y": "${table_chunk.y}",
          "color": "${table_chunk.color}",
          "locked": "${table_chunk.locked}",
          "fields": "${table_chunk.fields}"
        },
        "expect": {
          "isError": false,
          "structuredContent.table_id": { "type": "string", "not_empty": true },
          "structuredContent.field_id_map": { "type": "object" }
        },
        "extract": {
          "actual_table_id": "$.structuredContent.table_id",
          "actual_field_id_map": "$.structuredContent.field_id_map"
        },
        "collect": {
          "table_id_map": { "key": "${table_chunk.id}", "value": "${actual_table_id}" },
          "field_id_map": { "merge_object": "${actual_field_id_map}" }
        }
      },
      {
        "step_id": 3,
        "name": "按 references 数组批量 create；端点只使用实际 ID",
        "for_each": {
          "items": "${remapped_reference_chunks}",
          "as": "reference_chunk",
          "serial": true,
          "max_argument_bytes": 49152
        },
        "method": "tools/call",
        "tool": "update_reference",
        "arguments": {
          "id": "${chunked_diagram_id}",
          "action": "create",
          "references": "${reference_chunk}"
        },
        "expect": {
          "isError": false,
          "structuredContent.id": { "equals": "${chunked_diagram_id}" },
          "structuredContent.revision": { "type": "integer", "minimum": 1 }
        }
      },
      {
        "step_id": 4,
        "name": "回读并对 fixture 做全保真比较",
        "method": "tools/call",
        "tool": "get_diagram",
        "arguments": { "id": "${chunked_diagram_id}" },
        "expect": {
          "structuredContent.diagram.tables": { "length": 54 },
          "structuredContent.diagram.tables[*].fields": { "total_length": 863 },
          "structuredContent.diagram.references": { "length": 76 },
          "structuredContent.diagram": {
            "semantic_equals_fixture": {
              "fixture": "${large_fixture}",
              "table_id_map": "${table_id_map}",
              "field_id_map": "${field_id_map}",
              "ignore": ["revision"],
              "reference_normalization": {
                "cardinality_to": "type_",
                "cascades": "UPPER_SNAKE_CASE"
              },
              "preserve": ["tables", "fields", "references", "areas", "notes", "field_attributes", "comments", "colors", "positions"]
            }
          }
        }
      },
      {
        "step_id": 5,
        "name": "清理分片图",
        "method": "tools/call",
        "tool": "delete_diagram",
        "arguments": { "id": "${chunked_diagram_id}", "confirm": true },
        "expect": { "structuredContent.deleted": { "equals": true } }
      }
    ]
  },
