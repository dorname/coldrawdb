        "extract": { "pre_room_snapshot": "$.structuredContent.diagram" }
      },
      {
        "step_id": 6,
        "name": "为已导入且含关系的图创建房间",
        "transport": "http",
        "method": "POST",
        "path": "/api/v1/rooms",
        "request": {
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer ${COLDRAWDB_ACCESS_TOKEN}"
          },
          "body": {
            "name": "S06 Endpoint Room",
            "diagramId": "${endpoint_diagram_id}"
          }
        },
        "expect": {
          "status": 201,
          "json": {
            "diagramId": { "equals": "${endpoint_diagram_id}" }
          }
        },
        "extract": { "endpoint_room_id": "$.id" }
      },
      {
        "step_id": 7,
        "name": "首个 MCP 房间写触发存量图物化并收到 op ack",
        "method": "tools/call",
        "tool": "update_table",
        "arguments": {
          "id": "${endpoint_diagram_id}",
          "table_id": "${actual_users_table_id}",
          "action": "update",
          "comment": "first-room-op"
        },
        "expect": {
          "isError": false,
          "structuredContent.revision": { "type": "integer", "minimum": 1 }
        }
      },
      {
        "step_id": 8,
        "name": "再读取证明物化不重键且关系/areas/notes 完整",
        "method": "tools/call",
        "tool": "get_diagram",
        "arguments": { "id": "${endpoint_diagram_id}" },
        "expect": {
          "structuredContent.diagram": {
            "preserves_snapshot_paths": {
              "snapshot": "${pre_room_snapshot}",
              "paths": [
                "tables[*].id",
                "tables[*].fields[*].id",
                "references[*].id",
                "references[*].startTableId",
                "references[*].startFieldId",
                "references[*].endTableId",
                "references[*].endFieldId",
                "areas[*].id",
                "notes[*].id",
                "areas",
                "notes"
              ]
            }
          },
          "structuredContent.diagram.references": { "length": 1 },
          "structuredContent.diagram.references[0].startTableId": { "equals": "${actual_users_table_id}" },
          "structuredContent.diagram.references[0].endFieldId": { "equals": "${actual_post_user_field_id}" },
          "structuredContent.diagram.areas[0].id": { "equals": "${actual_area_id}" },
          "structuredContent.diagram.notes[0].id": { "equals": "${actual_note_id}" }
        }
      },
      {
        "step_id": 9,
        "name": "归档测试房间",
        "transport": "http",
        "method": "DELETE",
        "path": "/api/v1/rooms/${endpoint_room_id}",
        "request": {
          "headers": { "Authorization": "Bearer ${COLDRAWDB_ACCESS_TOKEN}" }
        },
        "expect": { "status": 204 }
      },
      {
        "step_id": 10,
        "name": "清理端点链路图",
        "method": "tools/call",
        "tool": "delete_diagram",
        "arguments": { "id": "${endpoint_diagram_id}", "confirm": true },
        "expect": { "structuredContent.deleted": { "equals": true } }
      }
    ]
  }
]
